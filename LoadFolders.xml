<?xml version="1.0" encoding="utf-8"?>
<!--
  [파일 개요]
  림월드 버전별 로드 폴더를 지정합니다.
  공통 콘텐츠는 루트에서, 버전별 DLL은 1.6/1.7 폴더에서 읽습니다.
-->
<loadFolders>
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <li IfModActive="Ludeon.RimWorld.Anomaly">Compatibility/Anomaly</li>
    <li IfModActive="Ludeon.RimWorld.Odyssey">Compatibility/Odyssey</li>
    <!--
      미디블 오버홀이 켜져 있을 때만 읽는 폴더입니다.
      기본 Defs에는 미디블 없이도 도는 바닐라판을 두고, 여기서 같은 defName으로
      덮어써서 미디블판을 복원합니다. 나중에 읽는 폴더가 이깁니다.
    -->
    <li IfModActive="DankPyon.Medieval.Overhaul">Compatibility/MedievalOverhaul</li>
    <!--
      Sized Apparel이 켜져 있을 때만 읽는 폴더입니다. 종양 잉태 중 배가 불러오게 하는
      def 하나씩만 들어 있고, SA가 없으면 폴더가 아예 로드되지 않아 아무 영향이 없습니다.
      1세대와 2세대는 def 타입과 필드 표기가 달라 폴더를 나눴습니다.
    -->
    <li IfModActive="OTYOTY.SizedApparel">Compatibility/SizedApparel1</li>
    <li IfModActive="OTYOTY.SizedApparel2">Compatibility/SizedApparel2</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>1.7</li>
    <li IfModActive="Ludeon.RimWorld.Anomaly">Compatibility/Anomaly</li>
    <li IfModActive="Ludeon.RimWorld.Odyssey">Compatibility/Odyssey</li>
    <li IfModActive="DankPyon.Medieval.Overhaul">Compatibility/MedievalOverhaul</li>
    <!-- Sized Apparel compatibility is enabled after those mods ship a 1.7 assembly. -->
  </v1.7>
</loadFolders>
