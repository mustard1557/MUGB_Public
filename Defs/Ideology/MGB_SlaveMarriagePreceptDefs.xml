  <IssueDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>MUGB_SlaveMarriage</defName>
    <label>slave marriage</label>
    <iconPath>UI/Icons/MGB_slavemarriageicon</iconPath>
  </IssueDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>MUGB_SlaveMarriage_Forbidden</defName>
    <issue>MUGB_SlaveMarriage</issue>
    <label>forbidden</label>
    <description>Taking slaves as forced spouses is a corrupt and shameful practice.</description>
    <impact>Low</impact>
    <displayOrderInIssue>30</displayOrderInIssue>
    <displayOrderInImpact>300</displayOrderInImpact>
    <defaultSelectionWeight>1</defaultSelectionWeight>
    <comps />
  </PreceptDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>MUGB_SlaveMarriage_Acceptable</defName>
    <issue>MUGB_SlaveMarriage</issue>
    <label>acceptable</label>
    <description>Slave marriage is an ordinary extension of ownership and household order.</description>
    <impact>Low</impact>
    <displayOrderInIssue>20</displayOrderInIssue>
    <displayOrderInImpact>200</displayOrderInImpact>
    <defaultSelectionWeight>0.25</defaultSelectionWeight>
    <associatedMemes>
      <li>MUGB_ChildrenOfBlinia</li>
      <li>Supremacist</li>
      <li>MUGB_GoblinSupremacy</li>
    </associatedMemes>
    <comps />
  </PreceptDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>MUGB_SlaveMarriage_Preferred</defName>
    <issue>MUGB_SlaveMarriage</issue>
    <label>preferred</label>
    <description>A useful slave should be bound into the household and used as the master sees fit.</description>
    <impact>Low</impact>
    <displayOrderInIssue>10</displayOrderInIssue>
    <displayOrderInImpact>100</displayOrderInImpact>
    <defaultSelectionWeight>0</defaultSelectionWeight>
    <associatedMemes>
      <li>MUGB_ChildrenOfBlinia</li>
      <li>Supremacist</li>
      <li>MUGB_GoblinSupremacy</li>
      <li>Raider</li>
    </associatedMemes>
    <comps />
  </PreceptDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>MUGB_SlaveMarriage_Important</defName>
    <issue>MUGB_SlaveMarriage</issue>
    <label>important</label>
    <description>Forcing slaves into marriage is a rightful sign of mastery, fertility, and domination.</description>
    <impact>Medium</impact>
    <displayOrderInIssue>0</displayOrderInIssue>
    <displayOrderInImpact>0</displayOrderInImpact>
    <defaultSelectionWeight>0</defaultSelectionWeight>
    <associatedMemes>
      <li>MUGB_ChildrenOfBlinia</li>
      <li>MUGB_GoblinSupremacy</li>
      <li>Raider</li>
    </associatedMemes>
    <comps />
  </PreceptDef>

