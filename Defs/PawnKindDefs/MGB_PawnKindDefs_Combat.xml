  <!--
    고블린 폰카인드 & 장비 시스템 설계 최종문서 기준 1차 구현.
    범위: 문서 7절(원시/중세일반/분대장/광신도/특수공통) 38종.
    이번 라운드에서 제외한 것 (별도 후속 작업 필요):
    - 9절 비고블린 세력(고블린토벌대/고블린사냥꾼) 전용 FactionDef/PawnKindDef.
    - MUGB_GoblinTribe/MUGB_GoblinCivilTribe의 pawnGroupMakers는 2026-07-04에 1차 연결 완료.
      추후 부족/중세/광신도 세력 분화 시 각 세력별 풀을 더 세분화해야 함.
    - apparelRequired의 확률(chance) 착용 — 바닐라/현재 C#에 해당 필드 없음. 방패는 apparelTags 풀 혼합으로 근사.
    - 샤먼 어빌리티, Shell 레이어 강제 차단, 인피망토 날씨무관 착용 — 전용 C# 필요, 미구현.
    - "바닐라 무기 소수 혼합" 문구는 정확한 바닐라 weaponTags 값을 확인 못해 이번엔 생략.
  -->

  <PawnKindDef ParentName="TribalBase" Name="MUGB_GoblinCombatBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>MUGB_GoblinTribe</defaultFactionDef>
    <canBeSapper>false</canBeSapper>
    <minGenerationAge>13</minGenerationAge>
    <maxGenerationAge>32</maxGenerationAge>
    <techHediffsMoney>0~0</techHediffsMoney>
    <techHediffsChance>0</techHediffsChance>
    <gearHealthRange>0.8~1.4</gearHealthRange>
    <useFactionXenotypes>false</useFactionXenotypes>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <xenotypeSet>
      <xenotypeChances>
        <MUGB_Goblin>85</MUGB_Goblin>
        <MUGB_Hobgoblin>15</MUGB_Hobgoblin>
        <Baseliner>0</Baseliner>
      </xenotypeChances>
    </xenotypeSet>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>6~12</initialResistanceRange>
    <!-- Korean source intent: 바닐라 적대 NPC처럼 전투 직전 약물을 들고/먹는 흐름을 타게 한다. MUGB 고블린 약물 보장은 C# 후처리에서 부족할 때만 보정한다. -->
    <combatEnhancingDrugsChance>0.08</combatEnhancingDrugsChance>
    <combatEnhancingDrugsCount>0~1</combatEnhancingDrugsCount>
  </PawnKindDef>

