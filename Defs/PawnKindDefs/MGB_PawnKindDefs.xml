<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Temporary goblin pawn kinds.
    These keep faction/tool spawning on MUGB xenotypes until dedicated goblin roles,
    weapons, apparel, traders, and raid compositions are designed.
  -->

  <PawnKindDef ParentName="TribalBase" Name="MUGB_GoblinBareBrawlerBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>MUGB_GoblinTribe</defaultFactionDef>
    <combatPower>28</combatPower>
    <canBeSapper>false</canBeSapper>
    <apparelMoney>0~0</apparelMoney>
    <weaponMoney>0~0</weaponMoney>
    <minGenerationAge>13</minGenerationAge>
    <maxGenerationAge>28</maxGenerationAge>
    <techHediffsMoney>0~0</techHediffsMoney>
    <techHediffsChance>0</techHediffsChance>
    <gearHealthRange>1~1</gearHealthRange>
    <itemQuality>Awful</itemQuality>
    <invNutrition>0</invNutrition>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <xenotypeSet>
      <xenotypeChances>
        <MUGB_Goblin>99999</MUGB_Goblin>
        <MUGB_Hobgoblin>0</MUGB_Hobgoblin>
        <Baseliner>0</Baseliner>
      </xenotypeChances>
    </xenotypeSet>
    <useFactionXenotypes>false</useFactionXenotypes>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>8~14</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="MUGB_GoblinBareBrawlerBase">
    <defName>MUGB_GoblinBareBrawler</defName>
    <label>bare goblin brawler</label>
  </PawnKindDef>

  <PawnKindDef ParentName="MUGB_GoblinBareBrawlerBase">
    <defName>MUGB_HobgoblinBareBrawler</defName>
    <label>bare hobgoblin brawler</label>
    <combatPower>42</combatPower>
    <xenotypeSet>
      <xenotypeChances>
        <MUGB_Goblin>0</MUGB_Goblin>
        <MUGB_Hobgoblin>99999</MUGB_Hobgoblin>
        <Baseliner>0</Baseliner>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>

  <PawnKindDef ParentName="MUGB_GoblinBareBrawlerBase">
    <defName>MUGB_HobgoblinBoss</defName>
    <label>hobgoblin boss</label>
    <combatPower>60</combatPower>
    <minGenerationAge>18</minGenerationAge>
    <maxGenerationAge>35</maxGenerationAge>
    <factionLeader>true</factionLeader>
    <xenotypeSet>
      <xenotypeChances>
        <MUGB_Goblin>0</MUGB_Goblin>
        <MUGB_Hobgoblin>99999</MUGB_Hobgoblin>
        <Baseliner>0</Baseliner>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>

</Defs>
