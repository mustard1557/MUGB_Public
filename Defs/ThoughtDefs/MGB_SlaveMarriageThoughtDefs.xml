<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>MUGB_RejectedByMaster</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>rejected by master</label>
        <description>My master rejected me...</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_SpecialSlave</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_SpecialSlaveMarriageMood</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <!-- ko-KR 의도: "고블린 신부" / 노예결혼 유지 동안 상시 +10 -->
        <label>goblin bride</label>
        <description>My slave marriage to a goblin earns me treatment unlike that given to other slaves.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
      <li>
        <label>not a formal spouse</label>
        <description>I am bound to my master, but I am still not treated as a formal spouse.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_ViewedAsSpecialSlave</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_ViewedAsSpecialSlave</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>favored slave</label>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_OpinionOfGoblin</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_OpinionOfGoblin</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>reeking goblin</label>
        <baseOpinionOffset>-8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinSupremacyNonGoblinOpinion</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_GoblinSupremacyNonGoblinOpinion</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <!-- ko-KR 의도: 고블린 우월주의자가 하프고블린을 완전한 고블린보다 낮게 보지만, 순수 비고블린보다는 덜 깔봅니다. -->
        <label>half-goblin blood</label>
        <baseOpinionOffset>-3</baseOpinionOffset>
      </li>
      <li>
        <!-- ko-KR 의도: 고블린 우월주의자가 고블린 코어/홉고블린 프레임 유전자가 없는 인간형을 하등한 종족으로 봅니다. -->
        <label>lesser breed</label>
        <baseOpinionOffset>-8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinHusband</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_GoblinSlaveSpouseOpinion</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <!-- ko-KR 번역은 꼭 "고블린 서방님"으로 유지 -->
        <label>goblin husband</label>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_NonGoblinMasterSpouseOpinion</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_NonGoblinSlaveSpouseOpinion</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>master</label>
        <baseOpinionOffset>-3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_RegularSpouseHasConcubineMood</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_RegularSpouseHasConcubineMood</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>my spouse has a concubine</label>
        <description>Was I not enough for my spouse?</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_RegularSpouseTookConcubineOpinion</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_RegularSpouseTookConcubineOpinion</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>took a concubine</label>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_OpinionOfSpousesConcubine</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_OpinionOfSpousesConcubine</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>concubine</label>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AttendedSlaveMarriageCeremony</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li><label>awful slave marriage ceremony</label><description>The ceremony was a graceless embarrassment.</description><baseMoodEffect>-1</baseMoodEffect></li>
      <li><label>poor slave marriage ceremony</label><description>The ceremony was plain, but at least it ended without incident.</description><baseMoodEffect>1</baseMoodEffect></li>
      <li><label>decent slave marriage ceremony</label><description>The ceremony imposed a little order on the household.</description><baseMoodEffect>2</baseMoodEffect></li>
      <li><label>good slave marriage ceremony</label><description>The ceremony was conducted with satisfying confidence.</description><baseMoodEffect>3</baseMoodEffect></li>
      <li><label>impressive slave marriage ceremony</label><description>The ceremony made the household hierarchy feel undeniable.</description><baseMoodEffect>4</baseMoodEffect></li>
      <li><label>unforgettable slave marriage ceremony</label><description>The declaration was brutal, theatrical, and impossible to forget.</description><baseMoodEffect>5</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_LovinWithGoblinSlaveSpouse</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <!-- ko-KR 번역 메모: 네가 따로 다듬던 재치 있는 문구 자리. 현재 임시 의미는 "고블린 배우자와 같은 잠자리를 함". -->
        <label>shared bed with a goblin spouse</label>
        <description>That ugly goblin spouse still smells awful.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_SlaveSpouseDied</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>slave spouse died</label>
        <description>My slave-marriage spouse is gone.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_BrokenToySlaveSpouseDied</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <!-- ko-KR 의도 유지: "망가진 장난감" -->
        <label>broken toy</label>
        <description>They were a useful toy. What a shame.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_FreeMarriageUnderSlaveMarriageIdeo</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <!-- ko-KR 의도: 노예혼(첩제도)을 "중요시함"으로 믿는 정착민이 자유인끼리 정식결혼했을 때만 받는 -3 무드입니다. 노예혼 당사자, 노예, 기존 관계에는 적용하지 않습니다. -->
        <label>entered a free marriage</label>
        <description>A free marriage feels like an indulgence when slave marriage should be the proper household order.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
