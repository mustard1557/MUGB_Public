<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>MUGB_AteVegetableIngredient</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.75</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>ate plant scraps</label>
        <description>Ugh... Plant scraps in my teeth... Me hate plants... Me want meat... Me want human meat...</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_FleshCravingLow</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>MUGB.ThoughtWorker_FleshCravingLow</workerClass>
    <stages>
      <li>
        <label>flesh craving</label>
        <description>I need proper flesh. Ordinary food keeps me moving, but it does not quiet the cells.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>flesh thirst</label>
        <description>The craving is gnawing through my body. I need humanlike flesh soon.</description>
        <baseMoodEffect>-9</baseMoodEffect>
      </li>
      <li>
        <label>flesh-starved</label>
        <description>The body is starving at the cellular level. Flesh. Now.</description>
        <baseMoodEffect>-16</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinPregnancyBurden</defName>
    <workerClass>MUGB.Patches.ThoughtWorker_GoblinPregnancyBurden</workerClass>
    <stages>
      <li>
        <label>carrying a goblin child</label>
        <description>Ugh... no. It cannot be that filthy kind growing inside me. It cannot be.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>carrying another goblin child</label>
        <description>I remember what the last birth did to my body. This one feels wrong in the same way.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>body-straining goblin pregnancy</label>
        <description>My body has not recovered, and these things are taking more from me every day.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>dangerous goblin pregnancy</label>
        <description>This pregnancy feels like it could be the last thing my body survives.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GaveBirthToGoblinLitter</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
    </nullifyingHediffs>
    <stages>
      <li>
        <label>gave birth to a goblin litter</label>
        <description>The birth is over, but the memory of those small goblin bodies still makes my skin crawl.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinBabyBorn</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
    </nullifyingHediffs>
    <stages>
      <li>
        <label>{0} was born healthy</label>
        <description>The runt is healthy! Feed it well and soon it can dig tunnels and catch arrows for the tribe! My genes spread!</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinChildDiedRelief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>4</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
    </nullifyingHediffs>
    <stages>
      <li>
        <label>goblin child died</label>
        <description>The goblin child is gone. I feel a faint, shameful relief.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteProperFlesh</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.75</durationDays>
    <stages>
      <li>
        <label>ate proper flesh</label>
        <description>Proper flesh quiets the craving for a while.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteHeartGoblin</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.5</durationDays>
    <stages>
      <li>
        <label>ate heart</label>
        <description>Me fast! Heart thumping! Me full of strength!</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteBrainGoblin</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.5</durationDays>
    <stages>
      <li>
        <label>ate brain</label>
        <description>Memories coming in! One plus one is three! Me very clever!</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGoblinMeatDirect</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate raw goblin meat</label>
        <description>The smell was rancid, oily, and sharp. There was hair in every bite. Was that goblin meat?</description>
        <baseMoodEffect>-22</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGoblinMeatDirectCannibal</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate raw goblin meat</label>
        <description>Meat is meat, but goblin meat has a foul musk and too much hair. It was unpleasant.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGoblinMeatAsIngredient</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate goblin meat</label>
        <description>The meal smelled wrong. Something hairy stuck between my teeth. Was that a humanlike part?</description>
        <baseMoodEffect>-16</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGoblinMeatAsIngredientCannibal</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate goblin meat</label>
        <description>I can stomach humanlike meat, but goblin meat has a greasy smell and a bitter aftertaste.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGutSausageNonGoblin</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.75</durationDays>
    <stages>
      <li>
        <label>ate foul-smelling sausage</label>
        <description>Ugh... what is that smell? And why is there so much hair in it? Ptui.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGutStewNonGoblin</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.75</durationDays>
    <stages>
      <li>
        <label>ate a suspicious lumpy stew</label>
        <description>That reeking broth was boiled down until it turned to sludge. Revolting.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_AteGoblinFoodPreferred</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>0.25</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>ate goblin food</label>
        <description>The smell should have been revolting, but it felt oddly comforting.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
