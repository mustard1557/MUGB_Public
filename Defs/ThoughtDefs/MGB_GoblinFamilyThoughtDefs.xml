<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Korean source intent: 고블린은 형제(남매)의 죽음에 -2 정도만 뜨고 3일간만 지속. 바닐라 가족 사망 문구가 아니라 고블린식으로 가볍게 반응해야 함. -->
  <ThoughtDef>
    <defName>MUGB_GoblinSiblingDied</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>sibling died</label>
        <description>Littermate died... We rolled in same pit... Little sad. But goblins make many more, so me not worry!</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinColonistDied</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>5</stackLimit>
    <stages>
      <li>
        <label>colonist died</label>
        <description>Friend dead... Sad... But curious! What friend meat taste like? Bet it tasty!</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MUGB_GoblinFriendDied</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>friend died</label>
        <description>Goblin I played with is dead. Things might get a little boring, but that's fine! There are plenty more goblins!</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
