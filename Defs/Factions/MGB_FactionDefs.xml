<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    [파일 개요]
    고블린 전용 세력 정의입니다.

    원칙:
    - 내부 DefName은 MUGB_ 접두사를 유지합니다.
    - 기존 MUGB_GoblinTribe / MUGB_GoblinCivilTribe defName은 참조와 세이브 호환을 위해 유지합니다.
    - 일반 부족/야만 부족은 기존 두 Def를 정리해서 사용하고, 중세/광신도/사냥꾼단은 새 Def로 분리합니다.
    - 1차 구현에서는 정밀한 "플레이어에게만 중립" 관계 패치를 하지 않고 바닐라 세력 관계 흐름을 따릅니다.
      한국어 의도: 고블린 시작 시 일반 고블린은 낮은 중립, 비고블린 시작 시 일반 고블린도 적대.
  -->

  <FactionDef ParentName="TribeRoughBase">
    <defName>MUGB_GoblinTribe</defName>
    <raidLootMaker>MUGB_GoblinRaidLootMaker</raidLootMaker>
    <label>savage goblin tribe</label>
    <!-- 한국어 표시명: 야만 부족고블린 -->
    <description>A savage tribe of compact green-skinned goblins. They lack advanced technology and raw physical reach, but they survive through numbers, stubborn toxic resilience, and a willingness to swarm threats before those threats can settle in.</description>
    <pawnSingular>goblin</pawnSingular>
    <pawnsPlural>goblins</pawnsPlural>
    <leaderTitle>boss</leaderTitle>
    <factionNameMaker>NamerFactionMUGB_SavageTribe</factionNameMaker>
    <basicMemberKind>MUGB_GoblinKind_PrimitiveMelee</basicMemberKind>
    <fixedLeaderKinds>
      <li>MUGB_GoblinKind_PrimitiveChiefMelee</li>
      <li>MUGB_GoblinKind_SquadLeaderEarlyMelee</li>
    </fixedLeaderKinds>
    <factionIconPath>World/WorldObjects/MUGB/FactionIcons/MGB_HTribeA</factionIconPath>
    <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>42</configurationListOrderPriority>
    <classicIdeo>true</classicIdeo>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">MUGB_ChildrenOfBlinia</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MUGB_GoblinSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
    </requiredMemes>
    <caravanTraderKinds Inherit="False" />
    <visitorTraderKinds Inherit="False" />
    <baseTraderKinds Inherit="False" />
    <colorSpectrum Inherit="False">
      <li>(1, 1, 1)</li>
      <li>(1, 1, 1)</li>
    </colorSpectrum>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <MUGB_Goblin>900</MUGB_Goblin>
        <MUGB_Hobgoblin>100</MUGB_Hobgoblin>
      </xenotypeChances>
    </xenotypeSet>
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <commonality>70</commonality>
        <!-- KO intent: 1차 습격/분대 시스템. 별도 AI 없이 바닐라 Combat 그룹을 여러 편성으로 나눠 원시 고블린 무리감을 만든다. -->
        <options>
          <MUGB_GoblinKind_PrimitiveMelee>22</MUGB_GoblinKind_PrimitiveMelee>
          <MUGB_GoblinKind_PrimitiveSpear>18</MUGB_GoblinKind_PrimitiveSpear>
          <MUGB_GoblinKind_PrimitiveShock>10</MUGB_GoblinKind_PrimitiveShock>
          <MUGB_GoblinKind_PrimitiveRanged>16</MUGB_GoblinKind_PrimitiveRanged>
          <MUGB_GoblinKind_Captor>2</MUGB_GoblinKind_Captor>
          <MUGB_GoblinKind_PrimitiveChiefMelee>1</MUGB_GoblinKind_PrimitiveChiefMelee>
          <MUGB_GoblinKind_PrimitiveChiefRanged>1</MUGB_GoblinKind_PrimitiveChiefRanged>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>22</commonality>
        <!-- KO intent: 포획조/노예자폭병이 섞인 원시 고블린 습격. -->
        <options>
          <MUGB_GoblinKind_PrimitiveMelee>14</MUGB_GoblinKind_PrimitiveMelee>
          <MUGB_GoblinKind_PrimitiveShock>12</MUGB_GoblinKind_PrimitiveShock>
          <MUGB_GoblinKind_PrimitiveRanged>10</MUGB_GoblinKind_PrimitiveRanged>
          <MUGB_GoblinKind_Captor>8</MUGB_GoblinKind_Captor>
          <MUGB_GoblinKind_PrimitiveChiefMelee>1</MUGB_GoblinKind_PrimitiveChiefMelee>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>8</commonality>
        <!-- KO intent: 노획 화기/원거리 비중이 높은 드문 원시 고블린 습격. -->
        <options>
          <MUGB_GoblinKind_PrimitiveMelee>12</MUGB_GoblinKind_PrimitiveMelee>
          <MUGB_GoblinKind_PrimitiveSpear>8</MUGB_GoblinKind_PrimitiveSpear>
          <MUGB_GoblinKind_PrimitiveRanged>18</MUGB_GoblinKind_PrimitiveRanged>
          <MUGB_GoblinKind_PrimitiveGunner>10</MUGB_GoblinKind_PrimitiveGunner>
          <MUGB_GoblinKind_Captor>2</MUGB_GoblinKind_Captor>
          <MUGB_GoblinKind_PrimitiveChiefRanged>1</MUGB_GoblinKind_PrimitiveChiefRanged>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <MUGB_GoblinKind_Beggar>4</MUGB_GoblinKind_Beggar>
          <MUGB_GoblinKind_Slave>4</MUGB_GoblinKind_Slave>
          <MUGB_GoblinKind_PrimitiveMelee>8</MUGB_GoblinKind_PrimitiveMelee>
          <MUGB_GoblinKind_PrimitiveRanged>5</MUGB_GoblinKind_PrimitiveRanged>
          <MUGB_GoblinKind_Captor>2</MUGB_GoblinKind_Captor>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <MUGB_GoblinKind_PrimitiveMelee>18</MUGB_GoblinKind_PrimitiveMelee>
          <MUGB_GoblinKind_PrimitiveSpear>16</MUGB_GoblinKind_PrimitiveSpear>
          <MUGB_GoblinKind_PrimitiveRanged>16</MUGB_GoblinKind_PrimitiveRanged>
          <MUGB_GoblinKind_PrimitiveShock>10</MUGB_GoblinKind_PrimitiveShock>
          <MUGB_GoblinKind_Captor>3</MUGB_GoblinKind_Captor>
          <MUGB_GoblinKind_PrimitiveChiefMelee>1</MUGB_GoblinKind_PrimitiveChiefMelee>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="TribeBase">
