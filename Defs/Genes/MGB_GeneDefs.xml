<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    [파일 개요]
    MUGB 고블린/홉고블린의 핵심 유전자입니다.
    의도:
    - 바닐라 GeneDef와 VEF StatDef만으로 가능한 부분은 XML에서 처리해 틱 부담을 만들지 않습니다.
    - 머리/몸 강제는 유전자 적용 시점과 생성 완료 시점에 한 번만 보정합니다.
    - label/description은 영어 기본값이며, 아래 한국어 주석은 번역 작업 참고용입니다.
  -->

  <GeneDef ParentName="GeneVoiceBase">
    <defName>MGB_GoblinVoice</defName>
    <geneClass>MUGB.Gene_GoblinVoice</geneClass>
    <label>goblin voice</label>
    <description>Carriers vocalize with the harsh cries shared by goblins and hobgoblins. This gene is inactive without a goblin body-plan gene.</description>
    <iconPath>UI/Icons/Genes/MGB_GoblinVoice</iconPath>
    <displayOrderInCategory>135</displayOrderInCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <soundDeath>MGB_GoblinVoice_Scream</soundDeath>
    <soundWounded>MGB_GoblinVoice_Scream</soundWounded>
  </GeneDef>

  <GeneDef>
    <defName>MUGB_Gene_GoblinCore</defName>
    <geneClass>VEF.Genes.GeneGendered</geneClass>
    <label>goblin body plan</label>
    <!-- 한국어 설명 참고: 고블린 전용 머리, 귀, 피부색, 기본 체형을 부여하는 핵심 유전자입니다. -->
    <description>Carriers express the stable goblin body plan: green skin, a dedicated goblin head, pointed ears, and a compact frame.</description>
    <iconPath>UI/Icons/Genes/MGB_GoblinFrame</iconPath>
    <displayCategory>Cosmetic_Body</displayCategory>
    <displayOrderInCategory>10</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <endogeneCategory>BodyType</endogeneCategory>
    <exclusionTags>
      <li>BodyType</li>
      <li>MUGB_GoblinBodyPlan</li>
    </exclusionTags>
    <modExtensions>
      <li Class="VEF.Genes.GeneExtension">
        <!-- VEF 성별 제한/렌더 확장입니다. 여성 고블린 외형은 별도 구현 전까지 발현되지 않게 둡니다. -->
        <forGenderOnly>Male</forGenderOnly>
        <!-- bodyType 자체는 바닐라 Thin으로 유지하고, 몸 텍스처만 고블린 전용으로 바꿔 HAR/Character Editor와 충돌을 줄입니다. -->
        <forcedBodyType>Thin</forcedBodyType>
        <bodyNakedGraphicPath>Things/Pawn/MGBlike/Bodies/Naked_Thin</bodyNakedGraphicPath>
        <bodyDessicatedGraphicPath>Things/Pawn/MGBlike/Bodies/Dessicated/Dessicated_Thin</bodyDessicatedGraphicPath>
      </li>
    </modExtensions>
    <!-- GeneDef.bodyType은 바닐라 GeneticBodyType enum만 받습니다. 실제 텍스처는 VEF 확장과 MUGB 렌더 패치에서 교체합니다. -->
    <bodyType>Thin</bodyType>
    <skinColorOverride>(111, 116, 73)</skinColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <forcedHeadTypes>
      <li>MUGB_GoblinHead</li>
    </forcedHeadTypes>
    <statOffsets>
      <!-- 한국어 의도: 고블린은 거칠고 무딘 기질이라 인간보다 정신적으로 잘 버팁니다.
           추함/낮은 사회성/인육갈망이 상시로 기분을 깎는 구조라, 그 보정 없이는
           오히려 인간보다 자주 무너집니다. 음수일수록 정신붕괴 문턱이 낮아져 잘 안 터집니다. -->
      <MentalBreakThreshold>-0.07</MentalBreakThreshold>
    </statOffsets>
    <statFactors>
      <VEF_BodySize_Multiplier>0.8</VEF_BodySize_Multiplier>
      <!-- VEF는 실제 크기 배율과 cosmetic 배율을 size + cosmetic - 1로 합칩니다. 시각 크기를 실제 0.8배와 맞추려면 cosmetic은 1로 둡니다. -->
      <VEF_CosmeticBodySize_Multiplier>1.0</VEF_CosmeticBodySize_Multiplier>
      <VEF_HeadSize_Cosmetic>0.9</VEF_HeadSize_Cosmetic>
      <MeleeDamageFactor>0.92</MeleeDamageFactor>
      <PainShockThreshold>0.85</PainShockThreshold>
      <SocialImpact>0.8</SocialImpact>
      <NegotiationAbility>0.85</NegotiationAbility>
      <TradePriceImprovement>0.9</TradePriceImprovement>
      <PlantWorkSpeed>0.9</PlantWorkSpeed>
      <PlantHarvestYield>0.85</PlantHarvestYield>
      <MiningSpeed>1.05</MiningSpeed>
      <CookSpeed>1.05</CookSpeed>
      <ConstructionSpeed>0.95</ConstructionSpeed>
      <AimingDelayFactor>0.95</AimingDelayFactor>
      <ImmunityGainSpeed>1.05</ImmunityGainSpeed>
      <InjuryHealingFactor>1.25</InjuryHealingFactor>
      <LifespanFactor>0.5</LifespanFactor>
      <VEF_NegativeThoughtDurationFactor>0.9</VEF_NegativeThoughtDurationFactor>
    </statFactors>
    <statOffsets>
      <MoveSpeed>0.11</MoveSpeed>
      <CarryingCapacity>-4</CarryingCapacity>
    </statOffsets>
    <renderNodeProperties>
