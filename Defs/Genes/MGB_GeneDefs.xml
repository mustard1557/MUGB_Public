      <li>BodyType</li>
      <li>MUGB_GoblinBodyPlan</li>
    </exclusionTags>
    <modExtensions>
      <li Class="VEF.Genes.GeneExtension">
        <!-- VEF 성별 제한/렌더 확장입니다. 여성 홉고블린은 별도 구현 전까지 발현되지 않게 둡니다. -->
        <forGenderOnly>Male</forGenderOnly>
        <!-- bodyType 자체는 바닐라 Male로 유지하고, 몸 텍스처만 홉고블린 전용으로 바꿔 HAR/Character Editor와 충돌을 줄입니다. -->
