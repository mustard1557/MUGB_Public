      <li Class="MUGB.CompProperties_GoblinFuelGlower">
        <glowRadius>5.5</glowRadius>
        <glowColor>(120,60,35,0)</glowColor>
        <glowOnlyWithFuel>true</glowOnlyWithFuel>
      </li>
      <li Class="MUGB.CompProperties_GoblinBuildingFireVisual">
        <fireSize>0.75</fireSize>
        <fireOnlyWhenWorking>true</fireOnlyWhenWorking>
        <throwSmoke>true</throwSmoke>
        <smokeIntervalTicks>45</smokeIntervalTicks>
        <smokeSize>0.8</smokeSize>
        <smokeOffset>(0,0,0.22)</smokeOffset>
        <southOffset>(0,0,0.1)</southOffset>
        <northOffset>(0,0,-0.12)</northOffset>
        <eastOffset>(-0.28,0,0.04)</eastOffset>
        <westOffset>(0.28,0,0.04)</westOffset>
