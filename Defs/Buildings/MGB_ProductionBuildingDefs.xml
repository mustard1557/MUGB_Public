<Defs>

  <ThingDef ParentName="BenchBase">
    <defName>MUGB_cookstation</defName>
    <label>goblin cookstation</label>
    <description>A heavy goblin cooking station for butchery, flesh preparation, and crude meals.</description>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MGB_cookstation/MGB_cookstation</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.55,3.55)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <drawOffsetWest>(0.35,0,0)</drawOffsetWest>
      <drawOffsetEast>(-0.3,0,0)</drawOffsetEast>
      <drawOffsetNorth>(0,0,-0.1)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0)</drawOffsetSouth>
    </graphicData>
    <tickerType>Normal</tickerType>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costStuffCount>80</costStuffCount>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MarketValue>100</MarketValue>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1</Flammability>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MUGB_Goblin</designationCategory>
    <uiOrder>2110</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>CookMealSimple</li>
      <li>CookMealSimpleBulk</li>
      <li>Make_Kibble</li>
      <li>MUGB_ButcherCorpseGoblinCookstation</li>
      <li>MUGB_SavorHumanDisassembly</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
      <li>MUGB.ITab_GoblinFuel</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3</heatPerSecond>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>48</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="MUGB.CompProperties_GoblinFuelFilter">
        <showFuelFilterToggles>false</showFuelFilterToggles>
        <allowWood>true</allowWood>
        <allowCoal>true</allowCoal>
      </li>
      <li Class="MUGB.CompProperties_GoblinFuelGlower">
        <glowRadius>5.5</glowRadius>
        <glowColor>(120,60,35,0)</glowColor>
        <glowOnlyWithFuel>true</glowOnlyWithFuel>
      </li>
      <li Class="MUGB.CompProperties_GoblinBuildingFireVisual">
        <fireSize>0.55</fireSize>
        <fireOnlyWhenWorking>true</fireOnlyWhenWorking>
        <throwSmoke>true</throwSmoke>
        <smokeIntervalTicks>45</smokeIntervalTicks>
        <smokeSize>0.65</smokeSize>
        <smokeOffset>(0,0,0.18)</smokeOffset>
        <southOffset>(0,0,0.18)</southOffset>
        <northOffset>(0,0,-0.12)</northOffset>
        <eastOffset>(-0.25,0,0.05)</eastOffset>
        <westOffset>(0.25,0,0.05)</westOffset>
      </li>
    </comps>
    <building>
      <isMealSource>true</isMealSource>
      <heatPerTickWhileWorking>0.10</heatPerTickWhileWorking>
    </building>
    <designationHotKey>Misc8</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

