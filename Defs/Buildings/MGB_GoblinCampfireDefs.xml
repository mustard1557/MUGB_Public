<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="MUGB_GoblinCampfireBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>MUGB.Building_GoblinCampfire</thingClass>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.7,1.7)</drawSize>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
      <damageData>
        <rect>(0.2,0,0.6,0.1)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.20</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>0</Flammability>
      <WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
    <selectable>true</selectable>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_Heater</li>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps Inherit="False">
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>10</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <functionsInVacuum>false</functionsInVacuum>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.12</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
              <li>MUGB_fireplace</li>
              <li>MUGB_campfire</li>
            </defs>
            <offsetPerBuilding>0.02</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <designationCategory>MUGB_Goblin</designationCategory>
    <designationHotKey>Misc1</designationHotKey>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <recipes>
      <li>CookMealSimple</li>
      <li>CookMealSimpleBulk</li>
      <li>Make_Pemmican</li>
      <li>Make_PemmicanBulk</li>
      <li>BurnApparel</li>
      <li>BurnWeapon</li>
      <li>BurnDrugs</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFood</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFoodBulk</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <destroySound>BuildingDestroyed_Wood_Small</destroySound>
    </building>
  </ThingDef>

  <ThingDef ParentName="MUGB_GoblinCampfireBase">
    <defName>MUGB_fireplace</defName>
    <label>goblin fireplace</label>
    <description>A compact goblin hearth built from alloy, timber, and bone. It cooks everything a campfire can while burning fuel more efficiently.</description>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Building/Misc/MGB_fireplace</texPath>
    </graphicData>
    <uiIconPath>Things/Building/Misc/MGB_fireplace</uiIconPath>
    <constructEffect>ConstructDirt</constructEffect>
    <statBases>
      <MarketValue>40</MarketValue>
      <MaxHitPoints>130</MaxHitPoints>
      <Mass>20</Mass>
      <WorkToBuild>350</WorkToBuild>
      <Flammability>0</Flammability>
      <WorkTableWorkSpeedFactor>0.55</WorkTableWorkSpeedFactor>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
    <costList>
      <MUGB_GoblinAlloy>25</MUGB_GoblinAlloy>
      <WoodLog>45</WoodLog>
      <MUGB_Bone>3</MUGB_Bone>
    </costList>
    <comps Inherit="False">
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>7</fuelConsumptionRate>
        <fuelCapacity>30</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <functionsInVacuum>false</functionsInVacuum>
      </li>
      <li Class="MUGB.CompProperties_GoblinFuelFilter">
        <showFuelFilterToggles>false</showFuelFilterToggles>
        <allowWood>true</allowWood>
        <allowCoal>true</allowCoal>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit"><offset>0.12</offset></li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li><li>TorchLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
              <li>MUGB_fireplace</li><li>MUGB_campfire</li>
            </defs>
            <offsetPerBuilding>0.02</offsetPerBuilding><radius>9.9</radius><maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <!--
      한국어 의도: 부모 MUGB_GoblinCampfireBase가 이미 ITab_Bills를 갖고 있습니다.
      여기서 다시 적으면 목록이 합쳐져 계획서 탭이 두 개로 보이고, 그중 하나에서 지시한 작업이
      수행되지 않습니다. 이 화로에만 필요한 연료 탭만 추가합니다.
      inspectorTabs는 Inherit="False"를 쓰지 않으면 부모 목록에 이어붙습니다.
    -->
    <inspectorTabs>
      <li>MUGB.ITab_GoblinFuel</li>
    </inspectorTabs>
    <uiOrder>2120</uiOrder>
  </ThingDef>

  <ThingDef ParentName="MUGB_GoblinCampfireBase">
    <defName>MUGB_campfire</defName>
    <label>goblin campfire</label>
    <description>A crude goblin campfire reinforced with stone and bone. It works like an ordinary campfire but holds more fuel and burns it a little more slowly.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MGB_campfire</texPath>
    </graphicData>
    <uiIconPath>Things/Building/Misc/MGB_campfire</uiIconPath>
    <costStuffCount>5</costStuffCount>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costList>
      <WoodLog>30</WoodLog>
      <MUGB_Bone>1</MUGB_Bone>
    </costList>
    <statBases>
      <MarketValue>20</MarketValue>
    </statBases>
    <comps Inherit="False">
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>8.5</fuelConsumptionRate>
        <fuelCapacity>24</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <functionsInVacuum>false</functionsInVacuum>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit"><offset>0.12</offset></li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li><li>TorchLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
              <li>MUGB_fireplace</li><li>MUGB_campfire</li>
            </defs>
            <offsetPerBuilding>0.02</offsetPerBuilding><radius>9.9</radius><maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <uiOrder>2119</uiOrder>
  </ThingDef>

</Defs>
