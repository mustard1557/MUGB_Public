<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Korean source intent:
    - 투창/스태프슬링/사슬올가미/잘자가스병은 같은 투척음을 공유한다.
    - 발사와 장전이 한 파일에 들어간 음원은 발사 순간 one-shot으로 시작해 파일 끝까지 재생한다.
    - 보병 연노와 대형연노는 같은 음원을 쓰되 대형연노만 더 크게 재생한다.
  -->

  <SoundDef Name="MUGB_GoblinWeaponOneShotBase" Abstract="True">
    <context>MapOnly</context>
    <maxSimultaneous>6</maxSimultaneous>
  </SoundDef>

  <SoundDef ParentName="MUGB_GoblinWeaponOneShotBase">
