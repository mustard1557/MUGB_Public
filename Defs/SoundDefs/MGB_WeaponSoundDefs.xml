    <subSounds><li><grains><li Class="AudioGrain_Clip"><clipPath>Weapon/Goblin/Thrown/GoblinThrowShared</clipPath></li></grains><volumeRange>40~40</volumeRange><pitchRange>0.97~1.03</pitchRange></li></subSounds>
  </SoundDef>
