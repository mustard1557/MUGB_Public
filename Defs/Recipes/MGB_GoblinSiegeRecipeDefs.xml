<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Alternative alloy inputs require explicit RecipeDefs. RecipeMakerProperties
       cannot declare ingredients or fixedIngredientFilter. -->
  <RecipeDef>
    <defName>MUGB_MakeGoblinHighExplosiveShell</defName>
    <label>make goblin high-explosive shell</label>
    <jobString>Making goblin high-explosive shell.</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workSkill>Crafting</workSkill>
    <displayPriority>92</displayPriority>
    <recipeUsers><li>MUGB_smithbench</li></recipeUsers>
    <researchPrerequisite>MUGB_GoblinSiegecraft</researchPrerequisite>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>MUGB_CrudeGoblinAlloy</li><li>MUGB_GoblinAlloy</li><li>MUGB_FineGoblinAlloy</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>MUGB_BoneDust</li></thingDefs></filter><count>10</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>MUGB_CrudeGoblinAlloy</li><li>MUGB_GoblinAlloy</li><li>MUGB_FineGoblinAlloy</li><li>MUGB_BoneDust</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><MUGB_GoblinHighExplosiveShell>1</MUGB_GoblinHighExplosiveShell></products>
  </RecipeDef>

