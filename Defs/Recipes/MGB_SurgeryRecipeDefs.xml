    <anesthetize>false</anesthetize>
    <displayPriority>250</displayPriority>
    <appliedOnFixedBodyParts>
      <li>Heart</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef>
    <defName>MUGB_ExtractFleshChunks</defName>
    <researchPrerequisite>MUGB_Research_Fleshcraft</researchPrerequisite>
    <label>extract meat chunks</label>
    <description>Hack usable meat chunks from a living humanlike patient. Success yields raw flesh chunks and removes two limbs; failure still yields flesh, but kills the patient.</description>
    <workerClass>MUGB.Recipe_ExtractFleshChunks</workerClass>
    <uiIconThing>Meat_Human</uiIconThing>
    <jobString>Extracting meat chunks.</jobString>
