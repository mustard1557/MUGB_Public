    <humanlikeOnly>true</humanlikeOnly>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <displayPriority>251</displayPriority>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef>
    <defName>MUGB_ExtractGoblinReproductiveSac</defName>
    <researchPrerequisite>MUGB_Research_Fleshcraft</researchPrerequisite>
    <label>extract goblin reproductive sac</label>
    <description>Drain and remove a goblin reproductive sac. The operation is crude but reliable, and the donor needs time before another sac can be taken.</description>
    <workerClass>MUGB.Recipe_ExtractGoblinReproductiveSac</workerClass>
    <uiIconThing>MUGB_GBroodSac</uiIconThing>
    <jobString>Extracting goblin reproductive sac.</jobString>
    <workAmount>220</workAmount>
    <effectWorking>Surgery</effectWorking>
    <soundWorking>Recipe_Surgery</soundWorking>
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workSkillLearnFactor>4</workSkillLearnFactor>
    <humanlikeOnly>true</humanlikeOnly>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <displayPriority>253</displayPriority>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef>
    <defName>MUGB_AdministerGoblinReproductiveSac</defName>
    <researchPrerequisite>MUGB_Research_Fleshcraft</researchPrerequisite>
    <label>administer goblin reproductive sac</label>
    <description>Force a harvested goblin reproductive sac into a non-goblin humanlike patient. This gives a large jump in goblin pheromone conditioning, but leaves the patient sickened and disgusted.</description>
    <workerClass>MUGB.Recipe_AdministerGoblinReproductiveSac</workerClass>
    <uiIconThing>MUGB_GBroodSac</uiIconThing>
    <jobString>Administering goblin reproductive sac.</jobString>
    <workAmount>180</workAmount>
    <effectWorking>Surgery</effectWorking>
    <soundWorking>Recipe_Surgery</soundWorking>
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workSkillLearnFactor>2</workSkillLearnFactor>
    <surgeryOutcomeEffect>SurgeryOutcomeBase</surgeryOutcomeEffect>
    <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
    <humanlikeOnly>true</humanlikeOnly>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <displayPriority>253</displayPriority>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MUGB_GBroodSac</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MUGB_GBroodSac</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

