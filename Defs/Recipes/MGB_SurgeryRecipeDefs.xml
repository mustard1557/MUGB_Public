<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>MUGB_ExtractBrain</defName>
    <researchPrerequisite>MUGB_Research_Fleshcraft</researchPrerequisite>
    <label>extract brain</label>
    <description>Crack open the skull and extract the brain for goblin cooking. Success yields a brain and skull; failure kills the patient without useful brain matter.</description>
    <workerClass>MUGB.Recipe_ExtractBrain</workerClass>
    <uiIconThing>MUGB_brain</uiIconThing>
    <jobString>Extracting brain.</jobString>
    <workAmount>900</workAmount>
    <effectWorking>Surgery</effectWorking>
    <soundWorking>Recipe_Surgery</soundWorking>
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <humanlikeOnly>true</humanlikeOnly>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <displayPriority>250</displayPriority>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef>
