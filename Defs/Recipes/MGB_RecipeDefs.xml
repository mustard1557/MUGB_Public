    <workAmount>900</workAmount>
    <workSkill>Medicine</workSkill>
    <displayPriority>20</displayPriority>
    <recipeUsers>
      <li>MUGB_druglab</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter><thingDefs><li>MUGB_Hgut</li><li>MUGB_Ggut</li></thingDefs></filter>
