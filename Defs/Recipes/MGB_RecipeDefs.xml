    <displayPriority>10</displayPriority>
    <uiIconThing>MUGB_Gfetus</uiIconThing>
    <recipeUsers>
      <li>MUGB_druglab</li>
      <li>DrugLab</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>MUGB_GBroodSac</li></thingDefs></filter>
