  <RecipeDef Name="MUGB_GoblinButcheryBase" Abstract="True">
    <description>Butcher a humanlike or animal corpse at a goblin cookstation.</description>
    <workerCounterClass>RecipeWorkerCounter_ButcherAnimals</workerCounterClass>
    <jobString>Butchering at the goblin cookstation.</jobString>
    <workAmount>450</workAmount>
    <workSpeedStat>ButcheryFleshSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <efficiencyStat>ButcheryFleshEfficiency</efficiencyStat>
    <effectWorking>ButcherFlesh</effectWorking>
    <soundWorking>Recipe_ButcherCorpseFlesh</soundWorking>
    <interruptIfIngredientIsRotting>true</interruptIfIngredientIsRotting>
    <uiIconThing>Meat_Goblin</uiIconThing>
    <displayPriority>5</displayPriority>
    <forceHiddenSpecialFilters>
      <li>AllowFresh</li>
    </forceHiddenSpecialFilters>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <specialProducts>
      <li>Butchery</li>
    </specialProducts>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
      </disallowedCategories>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
      <disallowDoesntProduceMeat>true</disallowDoesntProduceMeat>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
    </defaultIngredientFilter>
  </RecipeDef>

  <RecipeDef ParentName="MUGB_GoblinButcheryBase">
    <defName>MUGB_ButcherCorpseGoblinCookstation</defName>
    <label>goblin butchery</label>
    <description>Butcher a corpse at the goblin cookstation, producing the normal butchery products plus guts from humanlike bodies.</description>
  </RecipeDef>

  <RecipeDef ParentName="MUGB_GoblinButcheryBase">
    <defName>MUGB_SavorHumanDisassembly</defName>
    <researchPrerequisite>MUGB_Research_FineButchery</researchPrerequisite>
    <label>savor humanlike disassembly</label>
    <description>Carefully break down a humanlike corpse for goblin cooking. This takes longer, but extracts more usable flesh and always takes the skull if the head is present.</description>
    <jobString>Savoring humanlike disassembly.</jobString>
    <workAmount>720</workAmount>
    <uiIconThing>Skull</uiIconThing>
    <displayPriority>6</displayPriority>
    <fixedIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
      <disallowDoesntProduceMeat>true</disallowDoesntProduceMeat>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
    </defaultIngredientFilter>
  </RecipeDef>

  <RecipeDef>
    <defName>MUGB_ExtractVisceraFromCorpse</defName>
    <researchPrerequisite>MUGB_Research_Fleshcraft</researchPrerequisite>
    <label>extract viscera from corpse</label>
    <!-- 한국어 의도: 시체에서 내장 꺼내기. 고블린 조리대 도축과 달리 고기/가죽/뼈는 얻지 않고 인간형 시체에서 내장만 적게 꺼내는 야매 해체 레시피입니다. -->
    <description>Cut open a humanlike corpse and pull out usable viscera. This crude method yields only a small amount of guts and destroys the rest of the body instead of producing proper butcher products.</description>
    <workerClass>MUGB.Recipe_ExtractVisceraFromCorpse</workerClass>
    <workerCounterClass>RecipeWorkerCounter_ButcherAnimals</workerCounterClass>
    <jobString>Extracting viscera from corpse.</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>ButcheryFleshSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <efficiencyStat>ButcheryFleshEfficiency</efficiencyStat>
    <effectWorking>ButcherFlesh</effectWorking>
    <soundWorking>Recipe_ButcherCorpseFlesh</soundWorking>
    <interruptIfIngredientIsRotting>true</interruptIfIngredientIsRotting>
    <uiIconThing>MUGB_Hgut</uiIconThing>
    <displayPriority>4</displayPriority>
    <recipeUsers>
      <li>ButcherSpot</li>
      <li>TableButcher</li>
    </recipeUsers>
    <forceHiddenSpecialFilters>
      <li>AllowFresh</li>
    </forceHiddenSpecialFilters>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
      <disallowDoesntProduceMeat>true</disallowDoesntProduceMeat>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
    </defaultIngredientFilter>
  </RecipeDef>

  <RecipeDef>
    <defName>MUGB_ExtractBonesFromCorpse</defName>
    <label>salvage bone</label>
    <!-- 한국어 의도: 시체에서 뼈 추출하기. 썩거나 백골화되어 도축이 안 되는 인간형 시체에서
         인골만 뽑아냅니다. 시체는 이 과정에서 파괴됩니다. 신선한 시체는 대상에서 제외해
         (그건 도축으로 고기·인골을 함께 얻는 편이 낫습니다) 버려진 시체 회수 용도로만 씁니다.
         산출량은 고정 5개이며 작업대별 차이는 두지 않습니다. -->
    <description>Salvage usable bone from a rotting or skeletal humanlike corpse. Fresh corpses can't be salvaged here — butcher those instead to get meat and bone together.</description>
    <jobString>Salvaging bone from corpse.</jobString>
    <workAmount>280</workAmount>
    <workSpeedStat>ButcheryFleshSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0.25</workSkillLearnFactor>
    <efficiencyStat>ButcheryFleshEfficiency</efficiencyStat>
    <effectWorking>ButcherFlesh</effectWorking>
    <soundWorking>Recipe_ButcherCorpseFlesh</soundWorking>
    <uiIconThing>MUGB_Bone</uiIconThing>
    <displayPriority>3</displayPriority>
    <recipeUsers>
      <li>ButcherSpot</li>
      <li>TableButcher</li>
      <li>MUGB_cookstation</li>
    </recipeUsers>
    <products>
      <MUGB_Bone>5</MUGB_Bone>
    </products>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
      </disallowedCategories>
      <!-- 신선한 시체는 제외: 썩음/백골 상태만 잡힙니다(백골은 고기를 안 내므로 도축 불가). -->
      <specialFiltersToDisallow>
        <li>AllowFresh</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
    </defaultIngredientFilter>
  </RecipeDef>

