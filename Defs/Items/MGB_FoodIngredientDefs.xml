<Defs>

  <ThingDef>
    <defName>Meat_Goblin</defName>
    <label>goblin meat</label>
    <description>Raw meat carved from goblin flesh. It is treated much like human meat by most people, but goblins crave it more strongly than ordinary humanlike meat.</description>
    <thingClass>ThingWithComps</thingClass>
    <selectable>true</selectable>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Rare</tickerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <drawGUIOverlay>true</drawGUIOverlay>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stackLimit>75</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <tradeability>All</tradeability>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Beauty>-6</Beauty>
      <DeteriorationRate>6</DeteriorationRate>
      <Mass>0.03</Mass>
      <Flammability>0.5</Flammability>
      <Nutrition>0.055</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <MarketValue>0.7</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Food/Meat_Goblin</texPath>
      <graphicClass>MUGB.Graphic_GoblinThreeStageStackCount</graphicClass>
      <drawSize>(0.765,0.765)</drawSize>
    </graphicData>
    <thingCategories>
      <li>MUGB_HumanlikeMeatCategory</li>
    </thingCategories>
    <ingredient>
      <mergeCompatibilityTags>
        <li>GoblinMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

