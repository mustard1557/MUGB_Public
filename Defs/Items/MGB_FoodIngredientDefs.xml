  <ThingDef ParentName="MealBaseIngredientless">
    <defName>MUGB_gutstew</defName>
    <label>gut stew</label>
    <!-- 이 음식만 고블린 요리 공용 부모를 쓰지 않고 바닐라 부모를 직접 상속하므로 개별로 지정합니다. -->
    <thingCategories Inherit="False">
      <li>MUGB_GoblinFoodCategory</li>
    </thingCategories>
    <description>A thick goblin stew made from entrails and meat. Goblins consider it practical comfort food; most others consider it a mistake with steam.</description>
    <tradeability>All</tradeability>
    <graphicData>
      <texPath>Things/Item/Food/MGB_gutstew</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.765,0.765)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>11</MarketValue>
      <WorkToMake>220</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <stackLimit>20</stackLimit>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
    </ingestible>
    <comps>
      <li Class="CompProperties_Ingredients">
        <splitTransferableFoodKind>true</splitTransferableFoodKind>
      </li>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2.5</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MealBaseIngredientless" Name="MUGB_GoblinCookedMealBase" Abstract="True">
