<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MUGB_LiveButcheryAftermath</defName>
    <label>live butchery trauma</label>
    <description>The victim survived having meat hacked away while still alive. Phantom pain keeps flaring through the missing limbs.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>phantom pain</label>
        <painOffset>0.35</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_NosePickedLobotomy</defName>
    <label>goblin nose-pick lobotomy</label>
    <description>The frontal lobe was ruined through the nose with a crude goblin implement. What remains is calm, obedient, badly diminished, and barely troubled by goblin pheromones.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>lobotomized</label>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.9</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Talking</capacity>
            <postFactor>0.7</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.95</postFactor>
          </li>
        </capMods>
        <statOffsets>
          <PainShockThreshold>-0.10</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <GlobalLearningFactor>0.5</GlobalLearningFactor>
          <ResearchSpeed>0.3</ResearchSpeed>
          <SocialImpact>0.5</SocialImpact>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
