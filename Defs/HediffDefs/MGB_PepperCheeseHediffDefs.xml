<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MUGB_GoblinPepperCheeseFertility</defName>
    <label>pepper cheese pheromones</label>
    <description>Concentrated goblin pheromones temporarily increase reproductive capacity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>20000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <Fertility>1.20</Fertility>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
