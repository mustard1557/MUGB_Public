<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MUGB_GoblinRapidPostpartum</defName>
    <label>rapid goblin postpartum recovery</label>
    <description>Recently delivered goblin offspring, and is recovering far faster than such a birth should allow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_GoblinReproductiveSacDepleted</defName>
    <label>reproductive sac depleted</label>
    <description>This goblin's reproductive sac has been drained and needs time to recover.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <label>depleted</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_GoblinPregnancyDrain</defName>
    <label>goblin pregnancy drain</label>
    <description>Goblin offspring draw too much from this body during pregnancy. Hunger rises, movement slows, and the body collapses more easily under pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>drained</label>
        <hungerRateFactor>1.35</hungerRateFactor>
        <painOffset>0.05</painOffset>
        <capMods>
          <li><capacity>Consciousness</capacity><postFactor>0.95</postFactor></li>
        </capMods>
        <statOffsets>
          <MoveSpeed>-0.10</MoveSpeed>
          <PainShockThreshold>-0.05</PainShockThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_GoblinBirthStrain</defName>
    <label>goblin birth strain</label>
    <description>Goblin offspring drain far more nourishment from their mother than an ordinary pregnancy. Carrying and birthing them places a severe burden on the mother's body and leaves lasting complications.</description>
    <hediffClass>MUGB.Patches.Hediff_GoblinBirthStrain</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>4</maxSeverity>
    <stages>
      <li>
        <label>1/4</label>
        <minSeverity>1</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <label>2/4</label>
        <minSeverity>2</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <label>3/4</label>
        <minSeverity>3</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.60</setMax></li>
        </capMods>
      </li>
      <li>
        <label>4/4</label>
        <minSeverity>4</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
