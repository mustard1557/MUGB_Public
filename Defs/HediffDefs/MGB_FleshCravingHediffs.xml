<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MUGB_FleshCravingWeakness</defName>
    <label>flesh-starved weakness</label>
    <description>This goblin's cells are running short of humanlike flesh nutrients, slowing movement and worsening coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>craving</label>
        <minSeverity>0.50</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.10</MoveSpeed>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
      <li>
        <label>thirst</label>
        <minSeverity>0.80</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.14</MoveSpeed>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.20</offset></li>
        </capMods>
      </li>
      <li>
        <label>starved</label>
        <minSeverity>0.90</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.20</MoveSpeed>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.30</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
