<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MUGB_GloopJuiceHigh</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>high on gloopy juice</label>
    <labelNoun>a gloopy juice high</labelNoun>
    <description>Flooded with crude goblin combat stimulant. Pain is distant, limbs feel lighter, and fine focus is a little worse.</description>
    <defaultLabelColor>(0.75,0.95,0.35)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="MUGB.HediffCompProperties_AddHediffOnRemoved">
        <hediffDef>MUGB_GloopJuiceCrash</hediffDef>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.1</painFactor>
        <statFactors>
          <MoveSpeed>1.3</MoveSpeed>
        </statFactors>
        <statOffsets>
          <AimingDelayFactor>0.05</AimingDelayFactor>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.10</offset></li>
          <li><capacity>Sight</capacity><offset>-0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.10</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_GloopJuiceCrash</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>gloopy juice crash</label>
    <description>The crude goblin stimulant has burned out, leaving a fog behind it and hands that will not quite obey.</description>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-6</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_SpermJuiceHigh</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>high on tadpole vigor juice</label>
    <labelNoun>a tadpole vigor high</labelNoun>
    <description>Restless, energetic, fertile, and much more likely to pick a fight.</description>
    <defaultLabelColor>(0.95,0.75,0.35)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="MUGB.HediffCompProperties_AddHediffOnRemoved">
        <hediffDef>MUGB_SpermJuiceCrash</hediffDef>
        <setRestToZero>true</setRestToZero>
      </li>
    </comps>
    <stages>
      <li>
        <socialFightChanceFactor>1.3</socialFightChanceFactor>
        <statOffsets>
          <WorkSpeedGlobal>0.30</WorkSpeedGlobal>
        </statOffsets>
        <statFactors>
          <Fertility MayRequire="Ludeon.RimWorld.Biotech">4</Fertility>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_SpermJuiceCrash</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>tadpole vigor crash</label>
    <description>The stimulant rush is spent, and the body shakes with useless exhaustion.</description>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-6</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Manipulation</capacity><offset>-0.30</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MUGB_SmartyoilSynapticReconnection</defName>
    <label>synaptic reconnection</label>
    <description>Protein chains in smarty-oil have repaired parts of this goblin's damaged neural wiring, granting permanent cognitive improvement.</description>
    <maxSeverity>100</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>minor</label>
        <statFactors>
          <ResearchSpeed>1.03</ResearchSpeed>
          <SocialImpact>1.03</SocialImpact>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>improved</label>
        <statFactors>
          <ResearchSpeed>1.10</ResearchSpeed>
          <SocialImpact>1.05</SocialImpact>
          <GlobalLearningFactor>1.05</GlobalLearningFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>strong</label>
        <statFactors>
          <ResearchSpeed>1.20</ResearchSpeed>
          <SocialImpact>1.20</SocialImpact>
          <GlobalLearningFactor>1.10</GlobalLearningFactor>
        </statFactors>
        <capMods>
          <li><capacity>Manipulation</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>21</minSeverity>
        <label>complete</label>
        <statFactors>
          <ResearchSpeed>1.30</ResearchSpeed>
          <SocialImpact>1.30</SocialImpact>
          <GlobalLearningFactor>1.20</GlobalLearningFactor>
        </statFactors>
        <capMods>
          <li><capacity>Manipulation</capacity><offset>0.10</offset></li>
          <li><capacity>Consciousness</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
