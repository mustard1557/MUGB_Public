<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- VEF shield compatibility for MUGB weapons.
       Weapons tagged MUGB_ShieldForbidden are intentionally left untouched. -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName="MUGB_GoblinBoneHammer"]</xpath>
    <value>
      <li Class="VEF.Things.ThingDefExtension">
        <usableWithShields>true</usableWithShields>
      </li>
    </value>
  </Operation>

