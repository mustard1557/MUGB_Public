<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/HediffDef[defName="PregnantHuman"]/comps</xpath>
          <value>
            <li Class="MUGB.Patches.HediffCompProperties_MUGBGoblinPregnancyPlan" />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/HediffDef[defName="PregnancyLabor"]/comps</xpath>
          <value>
            <li Class="MUGB.Patches.HediffCompProperties_MUGBGoblinPregnancyPlan" />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/HediffDef[defName="PregnancyLaborPushing"]/comps</xpath>
          <value>
            <li Class="MUGB.Patches.HediffCompProperties_MUGBGoblinPregnancyPlan" />
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
