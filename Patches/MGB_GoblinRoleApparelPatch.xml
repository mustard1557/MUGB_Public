<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods><li>Ideology</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Add MUGB ritual garments to the vanilla leader apparel picker. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/PreceptDef[defName="IdeoRole_Leader"]/roleApparelRequirements</xpath>
          <value>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>FullHead</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_CultSkinMask</li></requiredDefs>
        </requirement>
      </li>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>Torso</li><li>Shoulders</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_HumanHideCapeB</li></requiredDefs>
        </requirement>
      </li>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>Torso</li><li>Shoulders</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_HumanHideMantle</li></requiredDefs>
        </requirement>
      </li>
          </value>
        </li>

        <!-- Moral guides use the same goblin ritual garments. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/PreceptDef[defName="IdeoRole_Moralist"]/roleApparelRequirements</xpath>
          <value>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>FullHead</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_CultSkinMask</li></requiredDefs>
        </requirement>
      </li>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>Torso</li><li>Shoulders</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_HumanHideCapeB</li></requiredDefs>
        </requirement>
      </li>
      <li>
        <anyMemeRequired>
          <li>MUGB_ChildrenOfBlinia</li>
          <li>MUGB_GoblinSupremacy</li>
        </anyMemeRequired>
        <requirement>
          <bodyPartGroupsMatchAny><li>Torso</li><li>Shoulders</li></bodyPartGroupsMatchAny>
          <requiredDefs><li>MUGB_Apparel_HumanHideMantle</li></requiredDefs>
        </requirement>
      </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
