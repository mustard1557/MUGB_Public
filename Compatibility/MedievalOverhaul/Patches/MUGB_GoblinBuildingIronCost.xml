<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--
    [파일 개요]
    미디블 오버홀이 켜져 있을 때만 읽히는 폴더입니다(LoadFolders.xml 참고).

    미디블에서는 강철이 사실상 후반 자원이라, 바닐라 강철을 고정재료로 요구하는
    생산건물은 중세 단계에서 지을 수가 없습니다. 그래서 미디블이 켜져 있을 때만
    강철 요구량을 같은 수량의 미디블 철괴로 바꿉니다.

    바꾸는 것은 재료 종류 하나뿐이고 수량, 작업량, 연구 선행, 그 밖의 어떤 값도
    건드리지 않습니다. 미디블이 없으면 이 폴더 자체가 로드되지 않으므로
    기본 Defs의 강철 요구가 그대로 남습니다.

    고블린 합금도 미디블 자원 흐름에 맞춰 고정 강철 대신 철괴를 사용합니다.
    철괴는 강철보다 덜 가공된 재료이므로 기존 강철량의 두 배를 요구하며,
    합금 등급은 여전히 별도로 투입한 가변 금속만으로 계산합니다.
  -->

  <!-- 고블린 대장간: 강철 60 -> 철괴 60 -->
  <Operation Class="PatchOperationSetName">
    <xpath>Defs/ThingDef[defName="MUGB_smithbench"]/costList/Steel</xpath>
    <name>DankPyon_IronIngot</name>
  </Operation>

  <!-- 고블린 연금술 테이블: 강철 45 -> 철괴 45 -->
  <Operation Class="PatchOperationSetName">
    <xpath>Defs/ThingDef[defName="MUGB_druglab"]/costList/Steel</xpath>
    <name>DankPyon_IronIngot</name>
  </Operation>

  <!-- 고블린 합금 공통 고정 필터: 강철 -> 철괴 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[@Name="MUGB_MakeGoblinAlloyBase"]/fixedIngredientFilter/thingDefs/li[text()="Steel"]</xpath>
    <value><li>DankPyon_IronIngot</li></value>
  </Operation>

  <!-- 고블린 합금 x5: 강철 1 -> 철괴 2 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="MUGB_MakeGoblinAlloy"]/ingredients/li[filter/thingDefs/li="Steel"]</xpath>
    <value>
      <li>
        <filter><thingDefs><li>DankPyon_IronIngot</li></thingDefs></filter>
        <count>2</count>
      </li>
    </value>
  </Operation>

  <!-- 고블린 합금 x50: 강철 10 -> 철괴 20 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="MUGB_MakeGoblinAlloyBulk50"]/ingredients/li[filter/thingDefs/li="Steel"]</xpath>
    <value>
      <li>
        <filter><thingDefs><li>DankPyon_IronIngot</li></thingDefs></filter>
        <count>20</count>
      </li>
    </value>
  </Operation>

  <!-- 고블린 합금 x100: 강철 20 -> 철괴 40 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="MUGB_MakeGoblinAlloyBulk100"]/ingredients/li[filter/thingDefs/li="Steel"]</xpath>
    <value>
      <li>
        <filter><thingDefs><li>DankPyon_IronIngot</li></thingDefs></filter>
        <count>40</count>
      </li>
    </value>
  </Operation>

</Patch>
